{
  "name": "cyberduck-recap",
  "version": "0.0.0",
  "private": true,
  "description": "A file-transfer client modeled on Cyberduck's behaviour",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "cyberduck-recap": "dist/bin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "audit": "pnpm audit --audit-level high"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "22",
    "@types/ssh2": "^1.15.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/credential-providers": "^3.1158.0",
    "@smithy/core": "3.37.0",
    "@smithy/node-http-handler": "^4.13.0",
    "ssh2": "^1.17.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "cpu-features",
      "ssh2"
    ]
  }
}
